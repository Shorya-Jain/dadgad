{
  "name": "dadgad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "chords": "tsx scripts/build-chord-library.ts",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name dadgad --branch main"
  },
  "devDependencies": {
    "@reticlehq/browser": "^3.7.0",
    "@reticlehq/vite-plugin": "^3.7.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.100.0"
  }
}
